# OpenRouter API key for MusicXML → LilyPond translation
OPENROUTER_API_KEY=

# OpenRouter model for MusicXML → LilyPond translation
# Model tiers (from cheaper to more expensive)
# Tier 1: google/gemini-2.0-flash-001, deepseek/deepseek-chat, qwen/qwen-2.5-coder-32b-instruct
# Tier 2: anthropic/claude-3-5-haiku, google/gemini-1.5-pro, openai/gpt-4o-mini, openai/gpt-4o
# Tier 3: anthropic/claude-3.5-sonnet, deepseek/deepseek-reasoner, openai/o3-mini
OPENROUTER_MODEL=google/gemini-2.0-flash-001
